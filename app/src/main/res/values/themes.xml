<resources>
    <style name="Theme.Khedmati" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/khedmati_primary</item>
        <item name="colorOnPrimary">@color/khedmati_on_primary</item>
        <item name="colorPrimaryContainer">@color/khedmati_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/khedmati_primary_dark</item>
        <item name="colorSecondary">@color/khedmati_secondary</item>
        <item name="colorOnSecondary">@color/khedmati_text_primary</item>
        <item name="colorSecondaryContainer">@color/khedmati_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/khedmati_text_primary</item>
        <item name="colorSurface">@color/khedmati_surface</item>
        <item name="colorSurfaceVariant">@color/khedmati_surface_soft</item>
        <item name="colorOnSurface">@color/khedmati_text_primary</item>
        <item name="colorOutline">@color/khedmati_outline</item>

        <item name="android:colorBackground">@color/khedmati_background</item>
        <item name="android:navigationBarColor">@color/khedmati_background</item>
        <item name="android:statusBarColor">@color/khedmati_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="fontFamily">sans-serif</item>

        <item name="android:buttonStyle">@style/Widget.Khedmati.Button</item>
        <item name="android:editTextStyle">@style/Widget.Khedmati.EditText</item>
    </style>

    <style name="Widget.Khedmati.Button" parent="@android:style/Widget.Material.Button">
        <item name="android:background">@drawable/bg_button_tonal</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:textColor">@color/khedmati_primary_dark</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:gravity">center</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Widget.Khedmati.EditText" parent="@android:style/Widget.Material.EditText">
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:textColor">@color/khedmati_text_primary</item>
        <item name="android:textColorHint">@color/khedmati_text_secondary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:minHeight">54dp</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="TextAppearance.Khedmati.Toolbar" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">@color/khedmati_text_primary</item>
        <item name="android:textSize">20sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
</resources>
